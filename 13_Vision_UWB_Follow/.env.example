# 攝影機與網頁
CAMERA_INDEX=0
HOST=0.0.0.0
PORT=5001
FRAME_WIDTH=640
FRAME_HEIGHT=480
YOLO_IMGSZ=320

# 車上 ESP32-UWB（USB 接到樹莓派，讀距離行 D:1.85）
UWB_SERIAL_PORT=/dev/ttyUSB0
UWB_BAUD=115200

# 樹莓派 → UNO 馬達命令（USB-TTL 或 GPIO UART）
# 例：USB-TTL 的 TX → UNO D10，共地
MOTOR_SERIAL_PORT=/dev/ttyUSB1
MOTOR_BAUD=9600

# 跟隨門檻（公尺）
START_DIST=2.0
STOP_DIST=1.8

# 畫面置中死區（|offset| 小於此值視為中央；offset 範圍約 -1～+1）
CENTER_DEADZONE=0.12

# UWB 超過此秒數沒更新 → 視為失效（置中時會停止）
UWB_STALE_SECONDS=1.0

# 馬達命令最短重送間隔（秒）
CMD_INTERVAL_SECONDS=0.15
