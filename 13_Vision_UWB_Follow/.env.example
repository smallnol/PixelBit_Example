# 攝影機與網頁
CAMERA_INDEX=0
HOST=0.0.0.0
PORT=5001
FRAME_WIDTH=640
FRAME_HEIGHT=480
YOLO_IMGSZ=320

# 車上 ESP32-UWB（USB 接到樹莓派，讀距離行 D:1.85）
UWB_SERIAL_PORT=/dev/ttyUSB0
UWB_BAUD=115200

# 樹莓派 → UNO 馬達命令
# 沒有 USB-TTL（Pi 5 用 GPIO 腳 8 TX → UNO D10）時填：
#   MOTOR_SERIAL_PORT=/dev/ttyAMA0
#   並在 /boot/firmware/config.txt 加：dtparam=uart0=on 後重開
# 注意：Pi 5 的 /dev/serial0 常指向 ttyAMA10（除錯座），不是 GPIO 腳 8！
# 有 USB-TTL 時才填 /dev/ttyUSB1
MOTOR_SERIAL_PORT=/dev/ttyAMA0
MOTOR_BAUD=9600

# 跟隨門檻（公尺）
START_DIST=2.0
STOP_DIST=1.8

# 畫面置中死區（|offset| 小於此值視為中央；offset 範圍約 -1～+1）
CENTER_DEADZONE=0.12

# UWB 超過此秒數沒更新 → 視為失效（置中時會停止）
UWB_STALE_SECONDS=1.0

# 馬達命令最短重送間隔（秒）
CMD_INTERVAL_SECONDS=0.15
