# 攝影機與網頁
CAMERA_INDEX=0
HOST=0.0.0.0
PORT=5001
FRAME_WIDTH=640
FRAME_HEIGHT=480
YOLO_IMGSZ=320

# 車上 ESP32-UWB（USB 接到樹莓派）
# 讀距離 D:1.85，並把馬達命令轉給 UNO
UWB_SERIAL_PORT=/dev/ttyUSB0
UWB_BAUD=115200

# 馬達命令（沒有 USB-TTL 時：跟上面填同一個口）
# Pi → USB → 車上 ESP32 → GPIO17 → UNO D10
MOTOR_SERIAL_PORT=/dev/ttyUSB0
MOTOR_BAUD=115200

# 跟隨門檻（公尺）
START_DIST=2.0
STOP_DIST=1.8

# 畫面置中死區（|offset| 小於此值視為中央；offset 範圍約 -1～+1）
CENTER_DEADZONE=0.12

# UWB 超過此秒數沒更新 → 視為失效（置中時會停止）
UWB_STALE_SECONDS=1.0

# 馬達命令最短重送間隔（秒）
CMD_INTERVAL_SECONDS=0.15
