# ===== 攝影機 / 網頁 =====
CAMERA_INDEX=0
HOST=0.0.0.0
PORT=5001
FRAME_WIDTH=640
FRAME_HEIGHT=480
YOLO_IMGSZ=320
TRACKER_CFG=bytetrack.yaml

# ===== 跟隨：車上 ESP32 USB（距離 + O:正前 + 馬達轉發）=====
# 接線：ESP32 USB→Pi；GPIO17→UNO D10；UNO D11→ESP32 GPIO16（O:）；GND 共地
# VL53×1 正前：VCC/GND/SDA/SCL；XSHUT 不接
UWB_SERIAL_PORT=/dev/ttyUSB0
UWB_BAUD=115200
MOTOR_SERIAL_PORT=/dev/ttyUSB0
MOTOR_BAUD=115200

START_DIST=2.0
STOP_DIST=1.8
CENTER_DEADZONE=0.12
UWB_STALE_SECONDS=1.0
TOF_STALE_SECONDS=1.0
CMD_INTERVAL_SECONDS=0.15
CMD_HEARTBEAT_SECONDS=0.8
AVOID_MM=250

# 目標遺失復原（無 AOA）：寬限 → 往最後方位轉 → 自轉 → 逾時停
LOST_GRACE_SECONDS=1.0
SEARCH_BIAS_SECONDS=3.0
Z_TIMEOUT_SECONDS=12.0

# 前進但 UWB 距離未拉近 → 視為卡住／細障推估 → 停
STUCK_SECONDS=4.0
STUCK_DIST_EPS=0.15

STOP_FOLLOW_ON_FALL=1
ENABLE_GESTURE_LOCK=1
GESTURE_LOCK_SECONDS=2.0
HSV_REID_THRESHOLD=0.60
HSV_REID_SEARCH=0.72
# track_id 命中但外觀低於此 → 視為 ID 對調，改用 HSV 重搜
HSV_ID_VERIFY=0.45

# ===== 跌倒偵測 / LINE =====
LINE_CHANNEL_ACCESS_TOKEN=你的_Channel_Access_Token
LINE_USER_ID=你的_LINE_User_ID
# 網頁「加入官方帳號」按鈕連結（LINE Official Account）
# 例：https://line.me/R/ti/p/@abcd1234
LINE_OA_URL=

IMGBB_API_KEY=
IMGBB_EXPIRATION_SECONDS=600
LITTERBOX_KEEP=1h
# PUBLIC_BASE_URL=https://xxxx.trycloudflare.com

ROLLING_BUFFER_SECONDS=30
FALL_SENSITIVITY=1.45
