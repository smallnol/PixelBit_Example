# ===== 攝影機 / 網頁 =====
CAMERA_INDEX=0
HOST=0.0.0.0
PORT=5001
FRAME_WIDTH=640
FRAME_HEIGHT=480
YOLO_IMGSZ=320

# ===== 跟隨：車上 ESP32 USB（距離 + 馬達命令轉發）=====
# 接線：ESP32 USB→Pi；ESP32 GPIO17→UNO D10；GND 共地
UWB_SERIAL_PORT=/dev/ttyUSB0
UWB_BAUD=115200
MOTOR_SERIAL_PORT=/dev/ttyUSB0
MOTOR_BAUD=115200

START_DIST=2.0
STOP_DIST=1.8
CENTER_DEADZONE=0.12
UWB_STALE_SECONDS=1.0
CMD_INTERVAL_SECONDS=0.15

# 確認跌倒後是否自動關閉跟隨（1=是）
STOP_FOLLOW_ON_FALL=1

# ===== 跌倒偵測 / LINE（與最新 12_Fall_Detection 對齊）=====
LINE_CHANNEL_ACCESS_TOKEN=你的_Channel_Access_Token
LINE_USER_ID=你的_LINE_User_ID

# 照片主力：ImgBB
IMGBB_API_KEY=
IMGBB_EXPIRATION_SECONDS=600

# 影片：litterbox → catbox → uguu → pomf → cloudflared
LITTERBOX_KEEP=1h
# CATBOX_USERHASH=
# PUBLIC_BASE_URL=https://xxxx.trycloudflare.com

ROLLING_BUFFER_SECONDS=30
# 跌倒靈敏度（預設 1.45；越大越敏感；桌前坐姿仍會排除）
FALL_SENSITIVITY=1.45
