# —— 跟隨服務（follow_aoa.py，port 5001）——
HOST=0.0.0.0
PORT=5001

# MaUWB AOA Anchor：USB-Native → 多半 /dev/ttyACM0
AOA_SERIAL_PORT=/dev/ttyACM0
AOA_BAUD=115200
# binary=USER_CMD 1；json=USER_CMD 0
AOA_MODE=binary
AOA_STALE_SECONDS=1.0
AOA_ANGLE_DEADZONE_DEG=10
# 左右反了改 -1
AOA_ANGLE_SIGN=1
# AOA 失效時：Z=自轉搜尋，S=停止
AOA_LOST_CMD=Z

# 馬達：USB-TTL → UNO D10（務必與 AOA 分口）
MOTOR_SERIAL_PORT=/dev/ttyUSB0
MOTOR_BAUD=9600
CMD_INTERVAL_SECONDS=0.15

START_DIST=2.0
STOP_DIST=1.8
