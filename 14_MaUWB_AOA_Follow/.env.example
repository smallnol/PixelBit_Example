# 跟隨來源：aoa | vision | fused
FOLLOW_SOURCE=aoa

# MaUWB AOA Anchor（USB-Native → 多半是 /dev/ttyACM0）
AOA_SERIAL_PORT=/dev/ttyACM0
AOA_BAUD=115200
# binary = user_cmd==1 跟隨幀（0x2A ... 0x23）；json = 預設 JS{"TWR":...}
AOA_MODE=binary
AOA_STALE_SECONDS=1.0
AOA_ANGLE_DEADZONE_DEG=10
# 若左右反了改成 -1
AOA_ANGLE_SIGN=1

# 馬達命令 → UNO D10（務必與 AOA 分開；不再走 ESP32 USB 轉發）
MOTOR_SERIAL_PORT=/dev/ttyUSB0
MOTOR_BAUD=9600

# 距離門檻（公尺；AOA 報 cm，程式內換算）
START_DIST=2.0
STOP_DIST=1.8

# 視覺備用（FOLLOW_SOURCE=vision 或 fused）
CAMERA_INDEX=0
HOST=0.0.0.0
PORT=5001
FRAME_WIDTH=640
FRAME_HEIGHT=480
YOLO_IMGSZ=320
CENTER_DEADZONE=0.12
CMD_INTERVAL_SECONDS=0.15
