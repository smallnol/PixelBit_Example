# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=你的_Channel_Access_Token
LINE_USER_ID=你的_LINE_User_ID

# 照片主力：ImgBB（https://api.imgbb.com/）
IMGBB_API_KEY=
# 照片圖床自動刪除秒數（600 = 10 分鐘）
IMGBB_EXPIRATION_SECONDS=600

# 影片主力：litterbox（只支援 1h / 12h / 24h / 72h）
LITTERBOX_KEEP=1h

# 循環緩衝秒數（跌倒前情）
ROLLING_BUFFER_SECONDS=30

CAMERA_INDEX=0
HOST=0.0.0.0
PORT=5000
