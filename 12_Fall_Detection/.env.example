# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=你的_Channel_Access_Token
LINE_USER_ID=你的_LINE_User_ID

# 照片主力：ImgBB（https://api.imgbb.com/）
IMGBB_API_KEY=
# 照片圖床自動刪除秒數（600 = 10 分鐘）
IMGBB_EXPIRATION_SECONDS=600

# 影片：litterbox（1h/12h/24h/72h）→ catbox → uguu/pomf → cloudflared
LITTERBOX_KEEP=1h
# 可選：catbox 帳號 userhash（匿名被 412 擋時有時有用）
# CATBOX_USERHASH=
# 可選：cloudflared 最新 https 網址（圖床全掛時的最後備援）
# PUBLIC_BASE_URL=https://xxxx.trycloudflare.com

# 循環緩衝秒數（跌倒前情）
ROLLING_BUFFER_SECONDS=30
# 跌倒靈敏度（預設 1.45；1.0 偏嚴幾乎要躺平，1.6~1.8 更易抓蹲下）
FALL_SENSITIVITY=1.45

CAMERA_INDEX=0
HOST=0.0.0.0
PORT=5000
