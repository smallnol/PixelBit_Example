# LINE Messaging API（請到 LINE Developers 重新產生 Token，勿使用曾貼到聊天室的舊 Token）
LINE_CHANNEL_ACCESS_TOKEN=你的_Channel_Access_Token
LINE_USER_ID=你的_LINE_User_ID

# 對外 HTTPS 網址（cloudflared / ngrok 等），用來讓 LINE 抓取照片與影片
# 例：https://xxxx.trycloudflare.com
PUBLIC_BASE_URL=

# 可選：沒有 PUBLIC_BASE_URL 時，用 ImgBB 上傳跌倒照片（影片仍需 PUBLIC_BASE_URL）
# https://api.imgbb.com/ 申請免費 API key
IMGBB_API_KEY=

# 攝影機與伺服器
CAMERA_INDEX=0
HOST=0.0.0.0
PORT=5000
