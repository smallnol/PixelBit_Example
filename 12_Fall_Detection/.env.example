# LINE Messaging API（請到 LINE Developers 重新產生 Token，勿使用曾貼到聊天室的舊 Token）
LINE_CHANNEL_ACCESS_TOKEN=你的_Channel_Access_Token
LINE_USER_ID=你的_LINE_User_ID

# 可選備援：cloudflared / ngrok 的 https 網址
# 現版預設會先上傳 catbox 給 LINE（比 quick tunnel 穩）；此欄可留空
PUBLIC_BASE_URL=

# 可選：ImgBB 照片上傳（有填會優先於 catbox）
# https://api.imgbb.com/
IMGBB_API_KEY=

# 攝影機與伺服器
CAMERA_INDEX=0
HOST=0.0.0.0
PORT=5000
