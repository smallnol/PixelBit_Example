# LINE Messaging API（請到 LINE Developers 重新產生 Token，勿使用曾貼到聊天室的舊 Token）
LINE_CHANNEL_ACCESS_TOKEN=你的_Channel_Access_Token
LINE_USER_ID=你的_LINE_User_ID

# 可選備援：cloudflared / ngrok 的 https 網址（可留空）
PUBLIC_BASE_URL=

# ImgBB 照片上傳（建議設定，LINE 氣泡才能穩定顯示照片）
# 申請：https://api.imgbb.com/
IMGBB_API_KEY=

# ImgBB 自動刪除秒數（最短 60）。600 = 10 分鐘
IMGBB_EXPIRATION_SECONDS=600

# 攝影機與伺服器
CAMERA_INDEX=0
HOST=0.0.0.0
PORT=5000
